# Dev-only image for the Base44 sandbox: dependencies live in the image, source is bind-mounted.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# `emergentintegrations` resolves only from Emergent's private index and nothing in this codebase
# imports it, so it is skipped here instead of editing the project's shared requirements file.
COPY requirements.txt /tmp/requirements.txt
RUN grep -v '^emergentintegrations' /tmp/requirements.txt > /tmp/requirements.sandbox.txt \
    && pip install -r /tmp/requirements.sandbox.txt

EXPOSE 8000
